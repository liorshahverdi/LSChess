{
  "name": "lschess",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/copy-engine.mjs && vite build",
    "predev": "node scripts/copy-engine.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "format": "prettier --write src tests scripts index.html package.json playwright.config.js",
    "format:check": "prettier --check src tests scripts index.html package.json playwright.config.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "stockfish": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.1"
  }
}
